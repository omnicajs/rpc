{
  "name": "@remote-ui/rpc",
  "description": "An RPC library with strong support for simulating the transfer of functions via postMessage",
  "version": "1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "esnext": "index.esnext",
  "types": "./build/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/ts/index.d.ts",
      "esnext": "./index.esnext",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@shopify/typescript-configs": "^5.1.2",
    "@types/node": "^18.0.0",
    "@types/uuid": "^8.0.0",
    "upstream-rpc": "npm:@remote-ui/rpc@^1.4.7",
    "uuid": "^8.2.0",
    "vitest": "^1.6.0"
  }
}
